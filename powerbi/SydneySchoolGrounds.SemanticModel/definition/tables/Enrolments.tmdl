table Enrolments
	lineageTag: 4310bfa6-36c2-407f-ad27-e55f92392c8c

	column school_key
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: ad4738ea-d719-03b1-c8a4-7aa3693008d1
		summarizeBy: none
		sourceColumn: school_key

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 1551c856-552c-9b40-a2f3-7e545285f5d6
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column students
		dataType: int64
		formatString: #,0
		lineageTag: ab375909-82a0-a8e0-6a91-682e44e2e738
		summarizeBy: none
		sourceColumn: students

		annotation SummarizationSetBy = Automatic

	partition Enrolments = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("schools/enrolments_long.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"school_key", "year", "students"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"school_key", Int64.Type}, {"year", Int64.Type}, {"students", Int64.Type}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
