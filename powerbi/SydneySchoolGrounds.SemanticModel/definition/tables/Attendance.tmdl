table Attendance
	lineageTag: 6d1460aa-ad85-e823-3c4f-1a794530f94c

	column school_key
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: e97bb1c2-de1e-4f07-2ec2-bb8f5abf57e9
		summarizeBy: none
		sourceColumn: school_key

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: ea905ffc-2a93-a341-2caa-2a23b2ff7abd
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column attendance_pct
		dataType: double
		formatString: 0.0
		lineageTag: 9f00062d-dd95-48e0-896c-1b796d96a7be
		summarizeBy: none
		sourceColumn: attendance_pct

		annotation SummarizationSetBy = Automatic

	partition Attendance = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("schools/attendance_long.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"school_key", "year", "attendance_pct"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"school_key", Int64.Type}, {"year", Int64.Type}, {"attendance_pct", type number}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
